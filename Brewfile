# Everything this config needs from Homebrew.
# Install it all with one command, run from this folder: brew bundle

# The editor itself.
brew "neovim"

# File and text search, used by fzf-lua.
brew "fzf"
brew "ripgrep"
brew "fd"

# Language servers: basedpyright (Pyright with more checks) and Ruff for
# Python, the last one for TypeScript and JavaScript (TypeScript 7 has the
# language server built in).
brew "basedpyright"
brew "ruff"
brew "typescript"

# Builds the tree-sitter parsers for syntax highlighting.
brew "tree-sitter-cli"

# Turns LaTeX math in markdown files ($x^2$) into Unicode text, for
# render-markdown (lua/config/markdown.lua).
brew "utftex"

# Icons only (file types, headings, checkboxes), no letters. In iTerm it is the
# font for non-ASCII text, so the letters stay in Menlo (see the README).
cask "font-symbols-only-nerd-font"

# Shows git diffs with colors and line numbers, in git and in the Space g preview.
brew "git-delta"

# Turns Caps Lock into Ctrl when held and Esc when tapped (rule in karabiner/).
cask "karabiner-elements"
