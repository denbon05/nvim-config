# Everything this config needs from Homebrew.
# Install it all with one command, run from this folder: brew bundle

# The editor itself.
brew "neovim"

# File and text search, used by fzf-lua.
brew "fzf"
brew "ripgrep"
brew "fd"

# Language servers: Pyright and Ruff for Python, the last one for TypeScript.
brew "pyright"
brew "ruff"
brew "typescript-language-server"

# Builds the tree-sitter parsers for syntax highlighting.
brew "tree-sitter-cli"

# Shows git diffs with colors and line numbers, in git and in the Space g preview.
brew "git-delta"
